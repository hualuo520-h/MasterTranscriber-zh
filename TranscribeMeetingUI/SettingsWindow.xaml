<Window x:Class="TranscribeMeetingUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="750" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#616161"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Browse Button Style -->
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#616161"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#424242"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PasswordBox Style -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2196F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- NumericUpDown Style (using TextBox) -->
        <Style x:Key="NumericTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="⚙️ 设置" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#212121"
                   Margin="0,0,0,20"/>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Transcription Provider Section -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🎙️ 转写引擎" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#212121" 
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="选择转写引擎：" 
                                   FontSize="13" 
                                   Foreground="#757575" 
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="TranscriptionProviderCombo" 
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="TranscriptionProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="本地（Whisper.cpp）" IsSelected="True"/>
                            <ComboBoxItem Content="Azure 语音转文本"/>
                        </ComboBox>

                        <!-- Local Whisper Settings -->
                        <StackPanel x:Name="LocalWhisperPanel" Margin="0,15,0,0">
                            <TextBlock Text="Whisper CLI 路径：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,0,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WhisperPathTextBox" 
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="浏览..." 
                                        Style="{StaticResource BrowseButton}"
                                        Click="BrowseWhisperPath_Click"/>
                            </Grid>

                            <TextBlock Text="Whisper 模型路径：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WhisperModelPathTextBox" 
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         IsReadOnly="True"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1" 
                                        Content="浏览..." 
                                        Style="{StaticResource BrowseButton}"
                                        Click="BrowseWhisperModel_Click"/>
                            </Grid>

                            <TextBlock Text="转写语言：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <ComboBox x:Name="WhisperLanguageCombo" 
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="自动检测" Tag="auto"/>
                                <ComboBoxItem Content="中文" Tag="zh"/>
                                <ComboBoxItem Content="英语" Tag="en"/>
                                <ComboBoxItem Content="日语" Tag="ja"/>
                                <ComboBoxItem Content="韩语" Tag="ko"/>
                                <ComboBoxItem Content="法语" Tag="fr"/>
                                <ComboBoxItem Content="德语" Tag="de"/>
                                <ComboBoxItem Content="西班牙语" Tag="es"/>
                                <ComboBoxItem Content="俄语" Tag="ru"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Azure STT Settings -->
                        <StackPanel x:Name="AzureSTTPanel" Margin="0,15,0,0" Visibility="Collapsed">
                            <TextBlock Text="Azure 语音 API 密钥：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="AzureSTTKeyTextBox" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="Azure 区域：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="AzureRegionTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="eastus"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- AI Summary Provider Section -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="✨ AI 摘要服务商" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#212121" 
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="选择 AI 服务商：" 
                                   FontSize="13" 
                                   Foreground="#757575" 
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="SummaryProviderCombo" 
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="SummaryProviderCombo_SelectionChanged">
                            <ComboBoxItem Content="DeepSeek API" IsSelected="True"/>
                            <ComboBoxItem Content="本地（Ollama）"/>
                        </ComboBox>

                        <!-- DeepSeek API Settings -->
                        <StackPanel x:Name="DeepSeekPanel" Margin="0,15,0,0">
                            <TextBlock Text="DeepSeek API 密钥：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,0,0,5"/>
                            <PasswordBox x:Name="DeepSeekKeyTextBox" 
                                         Style="{StaticResource ModernPasswordBox}"/>

                            <TextBlock Text="模型名称：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="DeepSeekModelTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="deepseek-chat"/>

                            <TextBlock Text="API 地址：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="DeepSeekApiUrlTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="https://api.deepseek.com/chat/completions"/>
                        </StackPanel>

                        <!-- Local Ollama Settings -->
                        <StackPanel x:Name="LocalOllamaPanel" Margin="0,15,0,0" Visibility="Collapsed">
                            <TextBlock Text="Ollama 模型名称：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="OllamaModelTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="llama3.1:8b"/>

                            <TextBlock Text="Ollama 地址：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <TextBox x:Name="OllamaUrlTextBox" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="http://localhost:11434"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Translation Section -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🌐 翻译（可选）" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#212121" 
                                   Margin="0,0,0,15"/>

                        <CheckBox x:Name="EnableTranslationCheckBox"
                                  Content="启用翻译"
                                  FontSize="13"
                                  Foreground="#424242"
                                  Margin="0,0,0,15"
                                  Checked="EnableTranslation_Changed"
                                  Unchecked="EnableTranslation_Changed"/>

                        <StackPanel x:Name="TranslationPanel" Visibility="Collapsed">
                            <TextBlock Text="DeepL API 密钥：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="DeepLKeyTextBox" 
                                     Style="{StaticResource ModernTextBox}"/>

                            <TextBlock Text="目标语言：" 
                                       FontSize="13" 
                                       Foreground="#424242" 
                                       Margin="0,10,0,5"/>
                            <ComboBox x:Name="TargetLanguageCombo" 
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="英语" Tag="EN-US" IsSelected="True"/>
                                <ComboBoxItem Content="西班牙语" Tag="ES"/>
                                <ComboBoxItem Content="法语" Tag="FR"/>
                                <ComboBoxItem Content="德语" Tag="DE"/>
                                <ComboBoxItem Content="意大利语" Tag="IT"/>
                                <ComboBoxItem Content="日语" Tag="JA"/>
                                <ComboBoxItem Content="韩语" Tag="KO"/>
                                <ComboBoxItem Content="简体中文" Tag="ZH"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Real-time Settings Section -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="⚡ 实时模式" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#212121" 
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="分块间隔（秒）：" 
                                   FontSize="13" 
                                   Foreground="#424242" 
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="RealTimeIntervalTextBox" 
                                     Style="{StaticResource NumericTextBox}"
                                     Text="30"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"/>
                            <TextBlock Text="秒" 
                                       FontSize="13" 
                                       Foreground="#757575" 
                                       VerticalAlignment="Center" 
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="建议：15–60 秒（越小更新越快，但 CPU 占用越高）" 
                                   FontSize="11" 
                                   Foreground="#9E9E9E" 
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- General Settings Section -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔧 通用" 
                                   FontSize="18" 
                                   FontWeight="SemiBold" 
                                   Foreground="#212121" 
                                   Margin="0,0,0,15"/>

                        <CheckBox x:Name="EnableSummaryCheckBox"
                                  Content="启用 AI 摘要生成"
                                  FontSize="13"
                                  Foreground="#424242"
                                  IsChecked="True"
                                  Margin="0,0,0,10"/>

                        <CheckBox x:Name="AutoExportCheckBox"
                                  Content="处理完成后自动导出"
                                  FontSize="13"
                                  Foreground="#424242"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" 
                    Content="保存" 
                    Style="{StaticResource ModernButton}"
                    Width="120"
                    Click="SaveButton_Click"/>
            <Button Grid.Column="3" 
                    Content="取消" 
                    Style="{StaticResource SecondaryButton}"
                    Width="120"
                    Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>